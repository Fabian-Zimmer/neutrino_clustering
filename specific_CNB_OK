def create_skymap(nu_density_array, params, cmap="magma", filename="skymap.png"):
    Nside = 8  # Corresponding to Npix = 768
    Npix = hp.nside2npix(Nside)
    
    # Normalization
    n_nu_pix_0 = params.N0_cm3 / Npix 
    norm_density = nu_density_array / n_nu_pix_0
    
    # Interpolation for the missing pixels
    missing_pixels = np.isnan(norm_density)

    if np.any(missing_pixels):
        neighbors = hp.get_all_neighbours(Nside, np.arange(len(norm_density)))

        for pix in np.where(missing_pixels)[0]:
            valid_neighbors = neighbors[:, pix][~np.isnan(norm_density[neighbors[:, pix]])]

            if len(valid_neighbors) > 0:
                norm_density[pix] = np.nanmean(norm_density[valid_neighbors])
    
    # Plot
    hp.mollview(norm_density, title="CNB Number Density Anisotropies", cmap=cmap, unit=r'$n_{\nu, pix} / n_{\nu, pix, 0}$',
                coord=["G"], min=np.min(norm_density), max=np.max(norm_density))
    hp.graticule()
    
    plt.savefig(filename, dpi=300)
    print(f"Skymap saved as {filename}")

