def extract_positions_and_velocities(file_path):
    """
    Extracts neutrino positions and velocities at two snapshots: today and high redshift.

    Args:
        file_path (str): Path to the vector file containing simulation data.

    Returns:
        tuple: (pos_today, pos_high_redshift, vels_today, vels_high_redshift)
            - pos_today: Positions at z=0 
            - pos_high_redshift: Positions at high redshift 
            - vels_today: Velocities at z=0 
            - vels_high_redshift: Velocities at high redshift 
    """
    # Load the vector file
    data = np.load(file_path)  


    pos_today = data[:, :, 0, :3]
    pos_high_redshift = data[:, :, 1, :3]

    vels_today = data[:, :, 0, 3:]
    vels_high_redshift = data[:, :, 1, 3:]

    return pos_today, pos_high_redshift, vels_today, vels_high_redshift

def calculate_masses(m_lightest, hierarchy='NH'):
    dm21_sq = 7.42e-5 * Params.eV**2
    dm31_sq = 2.514e-3 * Params.eV**2
    
    if hierarchy == 'NH':  # Normal hierarchy
        m1 = m_lightest
        m2 = np.sqrt(m1**2 + dm21_sq)
        m3 = np.sqrt(m1**2 + dm31_sq)
    elif hierarchy == 'IH':  # Inverted hierarchy
        m3 = m_lightest
        m1 = np.sqrt(m3**2 + dm31_sq)
        m2 = np.sqrt(m3**2 + dm21_sq)
    else:
        raise ValueError("Hierarchy must be 'NH' or 'IH'.")
    
    return [m1, m2, m3]


def velocities_to_momenta(m_lightest, vels_today, vels_high_redshift):
    masses = calculate_masses(m_lightest)  # Default hierarchy is 'NH'
    vels_today_magnitudes = np.linalg.norm(vels_today, axis=-1) * (Params.kpc / Params.s)
    vels_high_redshift_magnitudes = np.linalg.norm(vels_high_redshift, axis=-1) * (Params.kpc / Params.s)

    masses_broadcasted = np.array(masses)[None, None, :]  # Shape: (1, 1, 3)
    momenta_today = vels_today_magnitudes[..., None] * masses_broadcasted
    momenta_high_redshift = vels_high_redshift_magnitudes[..., None] * masses_broadcasted

    return momenta_today, momenta_high_redshift

def sort_momenta(m_lightest, vels_today, vels_high_redshift):
    momenta_today, momenta_high_redshift = velocities_to_momenta(m_lightest, vels_today, vels_high_redshift)

    magnitudes_today = jnp.linalg.norm(momenta_today, axis=-1)
    magnitudes_high_redshift = jnp.linalg.norm(momenta_high_redshift, axis=-1)

    ind_today = magnitudes_today.argsort(axis=-1)
    ind_high_redshift = magnitudes_high_redshift.argsort(axis=-1)

    momenta_today_sorted = jnp.take_along_axis(momenta_today, ind_today[..., None], axis=-2)
    momenta_high_redshift_sorted = jnp.take_along_axis(momenta_high_redshift, ind_high_redshift[..., None], axis=-2)

    return momenta_today_sorted, momenta_high_redshift_sorted

# Fermi-Dirac Distribution
def distribution_fermi_dirac(p_values, args):
    with np.errstate(over='ignore'):  # Suppress warnings
        return 1 / (np.exp(np.minimum(p_values / args.T_CNB, 100)) + 1)  # Clip large values


# Gaussian distribution (normalized)
def gaussian_normalized(p, N_nu_eff, y_star, sigma_star):
    def gaussian(q):
        return np.exp(-((q - y_star) ** 2) / (2 * sigma_star**2))

    integral, _ = quad(lambda q: gaussian(q) * q**3, 0, np.inf)
    A = N_nu_eff / (360 / (7 * params.Pi**4) * (11 / 4)**(4 / 3) * (params.T_CNB/params.T_CMB)**4 * integral)
    return A * np.exp(-((p/params.T_CNB - y_star) ** 2) / (2 * sigma_star**2))

# Lν-DR Case
def distribution_ldr(p_values, args):
    f_gaussian_ldr = gaussian_normalized(p_values, N_nu_eff=0.5, y_star=0.1, sigma_star=0.294218)
    return f_gaussian_ldr

# Hν Case
def distribution_hv(p_values, args):
    f_gaussian_hv = gaussian_normalized(p_values, N_nu_eff=3.044, y_star=30, sigma_star=4.82113)
    return f_gaussian_hv

# Hν-DR Case
def distribution_hvdr(p_values, args):
    f_gaussian_hvdr = gaussian_normalized(p_values, N_nu_eff=1.5, y_star=3, sigma_star=8.82654)
    return f_gaussian_hvdr

# LT+Mid Case
def distribution_ltmid(p_values, args):
    f_gaussian_ltmid = gaussian_normalized(p_values, N_nu_eff=2.3139, y_star=3.5, sigma_star=0.508274)
    f_fermi_dirac_ltmid = distribution_fermi_dirac(p_values * 2, args)
    f_combined_ltmid = f_gaussian_ltmid + f_fermi_dirac_ltmid
    return f_combined_ltmid


def number_density(m_lightest, vels_today, vels_high_redshift, pix_sr, args, distribution_func):
    momenta_today_sorted, momenta_high_redshift_sorted = sort_momenta(m_lightest, vels_today, vels_high_redshift)

    magnitudes_today = jnp.linalg.norm(momenta_today_sorted, axis=-1)
    magnitudes_high_redshift = jnp.linalg.norm(momenta_high_redshift_sorted, axis=-1)

    distribution_arr = distribution_func(magnitudes_high_redshift, args)

    # Calculate number density using integration
    y = magnitudes_today**3 * distribution_arr
    x = magnitudes_today
    n_raw = trap(y, jnp.log(x), axis=-1)

    # Multiply by constants and/or solid angles and convert to 1/cm^3
    n_cm3 = pix_sr * args.g_nu / ((2 * args.Pi)**3) * n_raw / (1 / args.cm**3)

    return jnp.array(n_cm3)

def plot_normalized_number_density(
    vels_today,
    vels_high_redshift,
    output_filename="normalized_number_density_vs_mass.png",
    selected_models=("SM (ΛCDM)", "Lν-DR", "Hν", "Hν-DR", "LT+Mid")
):
    fixed_mass_range = np.linspace(0.01, 0.3, 20)  

    models = {
        "SM (ΛCDM)": ("blue", "solid", distribution_fermi_dirac),
        "Lν-DR": ("red", "dashed", distribution_ldr),
        "Hν": ("green", "dotted", distribution_hv),
        "Hν-DR": ("purple", "dashdot", distribution_hvdr),
        "LT+Mid": ("orange", "solid", distribution_ltmid),
    }

    if selected_models is not None:
        models = {k: v for k, v in models.items() if k in selected_models}

    densities = {}

    for model, (_, linestyle, dist_func) in models.items():
        model_densities = []

        for fixed_mass in fixed_mass_range:
            # Compute momenta for fixed mass as p = mv
            momenta_today_fixed_mass = np.linalg.norm(vels_today, axis=-1) * fixed_mass
            momenta_high_redshift_fixed_mass = np.linalg.norm(vels_high_redshift, axis=-1) * fixed_mass

            # Sort momenta
            ind_today = np.argsort(momenta_today_fixed_mass, axis=-1)
            ind_high_redshift = np.argsort(momenta_high_redshift_fixed_mass, axis=-1)

            momenta_today_sorted = np.take_along_axis(momenta_today_fixed_mass, ind_today, axis=-1)
            momenta_high_redshift_sorted = np.take_along_axis(momenta_high_redshift_fixed_mass, ind_high_redshift, axis=-1)

            distribution_arr = dist_func(momenta_high_redshift_sorted, params)

            y = momenta_today_sorted**3 * distribution_arr
            x = momenta_today_sorted
            n_raw = trap(y, np.log(x), axis=-1)

            n_cm3 = pix_sr * params.g_nu / ((2 * params.Pi)**3) * n_raw / (1 / params.cm**3)

            model_densities.append(n_cm3)

        densities[model] = np.array(model_densities) / params.N0_cm3
    print("Momenta Today Shape:", np.shape(momenta_today_sorted))
    print("Momenta High Redshift Shape:", np.shape(momenta_high_redshift_sorted))

    # Plot
    plt.figure(figsize=(8, 6))

    for model, (color, linestyle, _) in models.items():
        plt.semilogx(
            fixed_mass_range, densities[model], label=model, color=color, linestyle=linestyle, linewidth=2
        )

    plt.xlabel(r"Neutrino Mass $m_\nu$ [eV]", fontsize=14)
    plt.ylabel(r"Normalized Number Density $n_\nu / n_{\nu,0}$", fontsize=14)
    plt.legend(fontsize=12)
    plt.grid(True, which="both", linestyle="--", alpha=0.6)

    plt.savefig(output_filename, dpi=150)
    plt.close()

    print(f"Plot saved as {output_filename}")

