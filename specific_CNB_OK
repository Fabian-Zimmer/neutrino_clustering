def extract_positions_and_velocities(file_path):
    """
    Extracts neutrino positions and velocities at two snapshots: today and high redshift.

    Args:
        file_path (str): Path to the vector file containing simulation data.

    Returns:
        tuple: (pos_today, pos_high_redshift, vels_today, vels_high_redshift)
            - pos_today: Positions at z=0 
            - pos_high_redshift: Positions at high redshift 
            - vels_today: Velocities at z=0 
            - vels_high_redshift: Velocities at high redshift 
    """
    # Load the vector file
    data = np.load(file_path)  


    pos_today = data[:, :, 0, :3]
    pos_high_redshift = data[:, :, 1, :3]

    vels_today = data[:, :, 0, 3:]
    vels_high_redshift = data[:, :, 1, 3:]

    return pos_today, pos_high_redshift, vels_today, vels_high_redshift

